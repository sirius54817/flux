<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── shadcn/ui Zinc Dark palette ── -->
    <!-- background: zinc-950 -->
    <color name="flux_background">#09090b</color>
    <!-- card / surface: zinc-900 -->
    <color name="flux_card">#18181b</color>
    <!-- elevated surface: zinc-800 -->
    <color name="flux_surface">#27272a</color>
    <!-- subtle muted: zinc-700 -->
    <color name="flux_muted">#3f3f46</color>
    <!-- border / divider: zinc-700 -->
    <color name="flux_border">#3f3f46</color>
    <!-- input field bg: zinc-800 -->
    <color name="flux_input">#27272a</color>

    <!-- foreground text: zinc-50 -->
    <color name="flux_foreground">#fafafa</color>
    <!-- muted foreground: zinc-400 -->
    <color name="flux_muted_foreground">#a1a1aa</color>
    <!-- placeholder: zinc-500 -->
    <color name="flux_placeholder">#71717a</color>

    <!-- primary action (white button) -->
    <color name="flux_primary">#fafafa</color>
    <color name="flux_primary_foreground">#18181b</color>

    <!-- destructive: red-500 -->
    <color name="flux_destructive">#ef4444</color>

    <!-- ring / focus: zinc-300 -->
    <color name="flux_ring">#d4d4d8</color>

    <!-- ── legacy aliases used by components ── -->
    <color name="dark">@color/flux_background</color>
    <color name="evenDarker">@color/flux_card</color>
    <color name="accent">@color/flux_ring</color>
    <color name="toolbarBackgroundColor">@color/flux_card</color>
    <color name="toolbarUrlBoxColor">@color/flux_input</color>
    <color name="icons">@color/flux_foreground</color>

    <!-- Tab counter tint override -->
    <color name="mozac_ui_tabcounter_default_tint" tools:ignore="UnusedResources">@color/flux_foreground</color>

</resources>
